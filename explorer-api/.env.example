# ── Explorer API Configuration ──
# Copy to .env and fill with real values.
# NEVER commit .env — it is gitignored but double-check before pushing.
# The SUPABASE_SERVICE_ROLE_KEY bypasses RLS — treat it as a root credential.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Quantos Node RPC
QUANTOS_RPC_URL=http://localhost:9944

# Indexer
POLL_INTERVAL_MS=2000
